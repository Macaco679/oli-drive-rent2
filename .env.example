# Copie este arquivo para ".env" e preencha com os valores reais do seu
# projeto Supabase (Project Settings → API). Nenhum valor real deve ser
# commitado neste arquivo.

# URL do projeto Supabase
SUPABASE_URL="https://SEU_PROJETO.supabase.co"
VITE_SUPABASE_URL="https://SEU_PROJETO.supabase.co"

# ID do projeto Supabase (parte antes de ".supabase.co" na URL acima)
VITE_SUPABASE_PROJECT_ID="SEU_PROJETO"

# Chave publishable/anon do Supabase (segura para uso no client-side;
# o acesso a dados é controlado por Row Level Security no banco)
SUPABASE_PUBLISHABLE_KEY="sua-chave-publishable-aqui"
VITE_SUPABASE_PUBLISHABLE_KEY="sua-chave-publishable-aqui"
